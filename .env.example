# =============================================================================
# Bussola Publica -- variaveis de ambiente
# =============================================================================
#
# COMO USAR:
#   Windows: copy .env.example .env
#   Linux:   cp .env.example .env
#   Depois edite o .env com seus valores reais.
#
# SEGURANCA:
#   NUNCA commite o arquivo .env no Git.
#   O .gitignore ja o exclui, mas confirme antes de qualquer `git add`.
#
# =============================================================================

# --- API Camara dos Deputados (publica, sem autenticacao) ---
CAMARA_API_BASE_URL=https://dadosabertos.camara.leg.br/api/v2
CAMARA_API_TIMEOUT_SECONDS=30
CAMARA_API_PAGE_SIZE=100
# default da API e 15; maximo e 100 -- mantenha 100 para minimizar chamadas

CAMARA_API_USER_AGENT=BussolaPublica/1.0 (projeto integrador; contato: time@bussola.local)

# --- Caminhos locais ---
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
LOG_LEVEL=INFO
# Niveis: DEBUG | INFO | WARNING | ERROR

# --- PostgreSQL / Supabase (Sprint 2+) ---
# PASSO A PASSO:
#   1. Acesse https://supabase.com e crie um projeto gratuito
#   2. Va em Settings > Database > Connection string > URI
#   3. Copie a string no formato abaixo e substitua [SUA_SENHA]
#
# Formato Supabase (producao):
DATABASE_URL=postgresql://postgres:[SUA_SENHA]@db.[SEU_PROJECT_REF].supabase.co:5432/postgres
#
# Formato local (desenvolvimento com PostgreSQL local):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bussola_publica

# --- OpenAI (Sprint 3) ---
# Necessario apenas para classificacao tematica e resumo executivo.
# Configure um hard cap de US$10/mes na dashboard da OpenAI antes de usar.
#
# OPENAI_API_KEY=sk-...
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_HARD_CAP_USD=10.0
