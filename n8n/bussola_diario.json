{
  "name": "Bussola Publica — Pipeline Diario",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 6 * * 1-5"
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Cron — 06h dias uteis",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "command": "cd /home/user/bussola-publica && source .venv/bin/activate && python scripts/run_pipeline.py --incremental 2>&1"
      },
      "id": "exec-pipeline",
      "name": "Executa Pipeline ETL",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [500, 300],
      "notes": "Substitua o path pelo caminho real do projeto no servidor onde o n8n esta rodando."
    },
    {
      "parameters": {
        "command": "cd /home/user/bussola-publica && source .venv/bin/activate && python scripts/run_ai_enrichment.py --limite 50 2>&1"
      },
      "id": "exec-ai",
      "name": "Enriquece com IA",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [750, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT p.proposicao_id, p.tipo, p.ementa, p.resumo_executivo, t.nome AS tema, p.data_apresentacao FROM fato_proposicoes p JOIN dim_temas t ON p.tema_id = t.tema_id WHERE t.critico = TRUE AND p.data_apresentacao >= CURRENT_DATE - INTERVAL '1 day' ORDER BY p.data_apresentacao DESC LIMIT 10;",
        "options": {}
      },
      "id": "query-criticos",
      "name": "Busca proposicoes criticas",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1000, 300],
      "credentials": {
        "postgres": {
          "id": "supabase-prod",
          "name": "Supabase Bussola Publica"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.length }}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      },
      "id": "if-tem-alertas",
      "name": "Tem proposicoes criticas?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1250, 300]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst linhas = items.map(i => {\n  const d = i.json;\n  return `*[${d.tema}] ${d.tipo}*\\n${d.ementa}\\n_Resumo: ${d.resumo_executivo || 'aguardando IA'}_`;\n}).join('\\n\\n---\\n\\n');\n\nreturn [{ json: { texto: `📋 *Bussola Publica — Alertas do Dia*\\n\\n${linhas}` } }];"
      },
      "id": "formata-mensagem",
      "name": "Formata mensagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1500, 200]
    },
    {
      "parameters": {
        "chatId": "SEU_CHAT_ID_TELEGRAM",
        "text": "={{ $json.texto }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "telegram-alerta",
      "name": "Envia alerta Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1750, 200],
      "credentials": {
        "telegramApi": {
          "id": "telegram-bot",
          "name": "Bussola Bot"
        }
      },
      "notes": "Configure: credencial Telegram com token do bot + SEU_CHAT_ID_TELEGRAM com o ID do chat destino."
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COUNT(*) FILTER (WHERE embedding IS NOT NULL) AS com_embedding, COUNT(*) FILTER (WHERE tema_id IS NOT NULL) AS classificadas, COUNT(*) FILTER (WHERE resumo_executivo IS NOT NULL) AS com_resumo, COUNT(*) AS total FROM fato_proposicoes;",
        "options": {}
      },
      "id": "query-metricas",
      "name": "Coleta metricas do banco",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1000, 500],
      "credentials": {
        "postgres": {
          "id": "supabase-prod",
          "name": "Supabase Bussola Publica"
        }
      }
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "value": "SEU_GOOGLE_SHEET_ID"
        },
        "sheetName": "metricas_diarias",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "data": "={{ new Date().toISOString().split('T')[0] }}",
            "total": "={{ $json.total }}",
            "com_embedding": "={{ $json.com_embedding }}",
            "classificadas": "={{ $json.classificadas }}",
            "com_resumo": "={{ $json.com_resumo }}"
          }
        }
      },
      "id": "gsheet-metricas",
      "name": "Registra metricas no Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1250, 500],
      "notes": "Opcional — configure credencial Google Sheets e substitua SEU_GOOGLE_SHEET_ID."
    }
  ],
  "connections": {
    "Cron — 06h dias uteis": {
      "main": [[{ "node": "Executa Pipeline ETL", "type": "main", "index": 0 }]]
    },
    "Executa Pipeline ETL": {
      "main": [[{ "node": "Enriquece com IA", "type": "main", "index": 0 }]]
    },
    "Enriquece com IA": {
      "main": [
        [{ "node": "Busca proposicoes criticas", "type": "main", "index": 0 }],
        [{ "node": "Coleta metricas do banco", "type": "main", "index": 0 }]
      ]
    },
    "Busca proposicoes criticas": {
      "main": [[{ "node": "Tem proposicoes criticas?", "type": "main", "index": 0 }]]
    },
    "Tem proposicoes criticas?": {
      "main": [
        [{ "node": "Formata mensagem", "type": "main", "index": 0 }],
        []
      ]
    },
    "Formata mensagem": {
      "main": [[{ "node": "Envia alerta Telegram", "type": "main", "index": 0 }]]
    },
    "Coleta metricas do banco": {
      "main": [[{ "node": "Registra metricas no Sheets", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": ["bussola-publica", "etl", "automacao"],
  "meta": {
    "templateCredsSetupCompleted": false,
    "instanceId": "bussola-publica-v1"
  }
}
