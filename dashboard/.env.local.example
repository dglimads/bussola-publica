# Copie para .env.local e preencha a anon/publishable key (somente leitura).
# .env.local esta no .gitignore e NUNCA vai para o Git.
# Use APENAS a anon key ou a publishable key (sb_publishable_...): publicas por
# design, somente leitura, mapeadas ao role anon (RLS leitura_publica).
# NUNCA use a service_role aqui.

NEXT_PUBLIC_SUPABASE_URL=https://yipwbjexekvrqgnpvjfn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole_sua_anon_key_aqui

# (Opcional) Realtime ao vivo. Padrao: false (publicacao publica usa polling 60s).
# So ligue em demo controlado + apos os GRANTs do sql/02_hardening_public.sql.
NEXT_PUBLIC_ENABLE_REALTIME=false
